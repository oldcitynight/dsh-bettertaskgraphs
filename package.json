{
  "name": "dsh-bettertaskgraphs",
  "version": "0.3.1-rc.31",
  "description": "Transactional task graphs with a conversation panel for DeepSeek Harness",
  "license": "GPL-3.0-only",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "task-graph"
  ],
  "homepage": "https://github.com/oldcitynight/dsh-bettertaskgraphs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldcitynight/dsh-bettertaskgraphs.git"
  },
  "bugs": {
    "url": "https://github.com/oldcitynight/dsh-bettertaskgraphs/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./core": "./core.mjs",
    "./store": "./store.mjs",
    "./host": "./host.mjs",
    "./interop": "./interop.mjs",
    "./client": "./client.js",
    "./extensions": "./extensions.mjs"
  },
  "files": [
    "client.js",
    "client.source.mjs",
    "cordis.patch.yml",
    "core.mjs",
    "host.mjs",
    "index.mjs",
    "interop.mjs",
    "journal.mjs",
    "projection.mjs",
    "remote.mjs",
    "scripts/build-client.mjs",
    "store.mjs",
    "tools.mjs",
    "view-model.mjs",
    "work-policy.mjs",
    "extensions.mjs",
    "VALIDATION.md",
    "DSH-COMPATIBILITY.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1 || 0.2.2-alpha.3"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "npm run check && node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "pack:bundle": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && npm pack --pack-destination dist"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1 || 0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1 || 0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1 || 0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
